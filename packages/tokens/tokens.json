{
  "$schema": "https://neptune.ly/signal/tokens.schema.json",
  "version": "0.2.0",
  "brand": {
    "name": "Neptune. Signal",
    "relationship": "Material 3 compatible financial design language"
  },
  "color": {
    "neptune": {
      "navy": "#07315F",
      "teal": "#00A8AE",
      "coral": "#EB4E4D",
      "beige": "#F0CE9D",
      "sky": "#3BC1EE"
    },
    "materialRole": {
      "primary": "{color.neptune.navy}",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "#E8F1FF",
      "onPrimaryContainer": "#061D38",
      "secondary": "#006D72",
      "onSecondary": "#FFFFFF",
      "secondaryContainer": "#D8F6F7",
      "onSecondaryContainer": "#073A3D",
      "tertiary": "{color.neptune.coral}",
      "onTertiary": "#FFFFFF",
      "tertiaryContainer": "#FFE5E4",
      "onTertiaryContainer": "#541312",
      "surface": "#FAFCFC",
      "surfaceDim": "#DCE6E8",
      "surfaceBright": "#FFFFFF",
      "surfaceContainerLowest": "#FFFFFF",
      "surfaceContainerLow": "#F4F8F8",
      "surfaceContainer": "#EEF5F5",
      "surfaceContainerHigh": "#E7F0F1",
      "surfaceContainerHighest": "#DDE8EA",
      "onSurface": "#071C2E",
      "onSurfaceVariant": "#60747C",
      "outline": "#C8D8DD",
      "outlineVariant": "#E0EAED",
      "inverseSurface": "#071C2E",
      "inverseOnSurface": "#FFFFFF",
      "error": "#C33131",
      "onError": "#FFFFFF",
      "errorContainer": "#FFE3E0",
      "onErrorContainer": "#5A1111"
    },
    "semantic": {
      "bankPrimary": "{color.materialRole.primary}",
      "bankSecondary": "{color.neptune.teal}",
      "bankAccent": "{color.materialRole.tertiary}",
      "bankInk": "{color.materialRole.onSurface}",
      "bankSurface": "{color.materialRole.surface}",
      "surfacePaper": "{color.materialRole.surface}",
      "surfaceCard": "{color.materialRole.surfaceContainerLowest}",
      "surfaceSoft": "{color.materialRole.surfaceContainer}",
      "textPrimary": "{color.materialRole.onSurface}",
      "textSecondary": "{color.materialRole.onSurfaceVariant}",
      "textInverse": "{color.materialRole.onPrimary}",
      "borderDefault": "{color.materialRole.outlineVariant}",
      "borderStrong": "{color.materialRole.outline}",
      "success": "#0B8F67",
      "warning": "#A96A13",
      "danger": "{color.materialRole.error}"
    }
  },
  "stateLayer": {
    "hover": 0.08,
    "focus": 0.12,
    "pressed": 0.12,
    "dragged": 0.16,
    "disabledContainer": 0.12,
    "disabledContent": 0.38
  },
  "elevation": {
    "level0": 0,
    "level1": 1,
    "level2": 3,
    "level3": 6,
    "level4": 8,
    "level5": 12
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40
  },
  "radius": {
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 22,
    "xl": 28,
    "full": 999
  },
  "typography": {
    "displayLarge": { "size": 44, "weight": 950, "lineHeight": 1.0 },
    "displayMedium": { "size": 36, "weight": 950, "lineHeight": 1.0 },
    "displaySmall": { "size": 32, "weight": 900, "lineHeight": 1.05 },
    "headlineLarge": { "size": 32, "weight": 950, "lineHeight": 1.1 },
    "headlineMedium": { "size": 28, "weight": 950, "lineHeight": 1.12 },
    "headlineSmall": { "size": 24, "weight": 900, "lineHeight": 1.16 },
    "titleLarge": { "size": 20, "weight": 950, "lineHeight": 1.15 },
    "titleMedium": { "size": 16, "weight": 900, "lineHeight": 1.2 },
    "titleSmall": { "size": 14, "weight": 900, "lineHeight": 1.2 },
    "bodyLarge": { "size": 16, "weight": 650, "lineHeight": 1.45 },
    "bodyMedium": { "size": 14, "weight": 650, "lineHeight": 1.45 },
    "bodySmall": { "size": 12, "weight": 650, "lineHeight": 1.4 },
    "labelLarge": { "size": 15, "weight": 950, "lineHeight": 1.2 },
    "labelMedium": { "size": 12, "weight": 850, "lineHeight": 1.25 },
    "labelSmall": { "size": 11, "weight": 850, "lineHeight": 1.25 },
    "displayBalance": { "size": 36, "weight": 950, "lineHeight": 1.0 },
    "pageTitle": { "size": 20, "weight": 950, "lineHeight": 1.15 },
    "sectionTitle": { "size": 15, "weight": 950, "lineHeight": 1.2 },
    "rowTitle": { "size": 14, "weight": 900, "lineHeight": 1.25 },
    "rowMeta": { "size": 11, "weight": 800, "lineHeight": 1.35 },
    "button": { "size": 15, "weight": 950, "lineHeight": 1.2 },
    "statusPill": { "size": 10, "weight": 900, "lineHeight": 1.1 }
  },
  "motion": {
    "pressMs": 160,
    "routeMs": 240,
    "containerTransformMs": 420,
    "resultMs": 320,
    "emphasizedEasing": "cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
